<%- include('../partials/header') %>

<div class="perfil-header">
  <div>
    <h1>Identidad visual</h1>
    <% if (iv) { %>
      <span class="badge badge-<%= iv.estado %>"><%= iv.estado === 'aprobado' ? 'Aprobado' : 'Borrador' %></span>
      <span class="version-tag">v<%= iv.version %></span>
      <% if (esHistorico) { %>
        <span class="badge badge-vacio">versión histórica</span>
      <% } %>
    <% } else { %>
      <span class="badge badge-vacio">Sin crear todavía</span>
    <% } %>
  </div>
  <div class="perfil-actions">
    <a href="/productos/<%= producto.slug %>/perfil">← perfil de producto</a>
    <a href="/productos/<%= producto.slug %>/identidad-visual/historial">Ver historial<% if (totalVersiones) { %> (<%= totalVersiones %>)<% } %></a>
  </div>
</div>

<% if (!perfilAprobado) { %>
  <p class="callout">
    Este producto todavía no tiene un perfil aprobado. Hace falta aprobar el perfil antes
    de definir la identidad visual —
    <a href="/productos/<%= producto.slug %>/perfil">ir al perfil de producto</a>.
  </p>
<% } else { %>

  <% if (error) { %>
    <p class="callout callout-error"><%= error %></p>
  <% } %>

  <p class="field-help">
    Esto define la base que va a usar la IA para generar el fondo de cada imagen en
    Contenido — no genera nada acá todavía. Logo opcional (si no subís uno, las imágenes
    van sin logo). Las 2 referencias son para guiar el estilo visual, no hace falta que
    sean perfectas.
  </p>

  <% if (readonly) { %>
    <div class="identidad-grid">
      <div>
        <p class="muted small">Logo</p>
        <% if (iv.logo) { %><img class="identidad-thumb" src="<%= iv.logo %>" alt="Logo"><% } else { %><p class="muted small">(sin logo)</p><% } %>
      </div>
      <% if (iv.referencia_1) { %>
        <div><p class="muted small">Referencia 1</p><img class="identidad-thumb" src="<%= iv.referencia_1 %>" alt="Referencia 1"></div>
      <% } %>
      <% if (iv.referencia_2) { %>
        <div><p class="muted small">Referencia 2</p><img class="identidad-thumb" src="<%= iv.referencia_2 %>" alt="Referencia 2"></div>
      <% } %>
    </div>
    <p class="muted small" style="margin-top:16px">Prompt de imagen:</p>
    <div class="field-readonly"><%= iv.prompt_imagen %></div>
  <% } else { %>
    <form method="POST" action="/productos/<%= producto.slug %>/identidad-visual" enctype="multipart/form-data">
      <div class="field">
        <label for="logo">Logo (opcional)</label>
        <% if (iv && iv.logo) { %><img class="identidad-thumb" src="<%= iv.logo %>" alt="Logo actual"><% } %>
        <input type="file" id="logo" name="logo" accept="image/*">
      </div>
      <div class="field">
        <label for="referencia_1">Referencia 1 — una imagen que represente el estilo que te gusta</label>
        <% if (iv && iv.referencia_1) { %><img class="identidad-thumb" src="<%= iv.referencia_1 %>" alt="Referencia 1 actual"><% } %>
        <input type="file" id="referencia_1" name="referencia_1" accept="image/*">
      </div>
      <div class="field">
        <label for="referencia_2">Referencia 2</label>
        <% if (iv && iv.referencia_2) { %><img class="identidad-thumb" src="<%= iv.referencia_2 %>" alt="Referencia 2 actual"><% } %>
        <input type="file" id="referencia_2" name="referencia_2" accept="image/*">
      </div>

      <div class="field">
        <label for="prompt_imagen">Prompt de tu imagen</label>
        <p class="field-help">
          Este es el texto que se le va a mandar a la IA para generar el fondo de cada
          pieza. Podés modificarlo agregando o quitando instrucciones — por ejemplo mood
          (alegre, formal), colores de marca, qué evitar.
        </p>
        <textarea id="prompt_imagen" name="prompt_imagen" rows="8"><%= (iv && iv.prompt_imagen) || '' %></textarea>
      </div>

      <div class="form-actions">
        <button type="submit">Guardar borrador</button>
        <% if (iv) { %>
          <button type="submit" formaction="/productos/<%= producto.slug %>/identidad-visual/aprobar" class="btn-primary">Aprobar identidad visual</button>
        <% } %>
      </div>
    </form>
  <% } %>

  <% if (readonly && !esHistorico) { %>
    <form method="POST" action="/productos/<%= producto.slug %>/identidad-visual/nueva-version">
      <button type="submit">Editar (crea versión nueva)</button>
    </form>
  <% } %>

<% } %>

<%- include('../partials/footer') %>
