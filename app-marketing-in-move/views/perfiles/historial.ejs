<%- include('../partials/header') %>

<h1>Historial de versiones</h1>
<p><a href="/productos/<%= producto.slug %>/perfil">&larr; volver al perfil actual</a></p>

<table class="table">
  <thead>
    <tr>
      <th>Versión</th>
      <th>Estado</th>
      <th>Creado</th>
      <th>Aprobado</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% versiones.forEach(function (v) { %>
      <tr>
        <td>v<%= v.version %></td>
        <td><span class="badge badge-<%= v.estado %>"><%= v.estado === 'aprobado' ? 'Aprobado' : 'Borrador' %></span></td>
        <td><%= new Date(v.creado_en).toLocaleDateString('es-AR') %></td>
        <td><%= v.aprobado_en ? new Date(v.aprobado_en).toLocaleDateString('es-AR') : '—' %></td>
        <td><a href="/productos/<%= producto.slug %>/perfil/version/<%= v.version %>">Ver</a></td>
      </tr>
    <% }); %>
    <% if (!versiones.length) { %>
      <tr><td colspan="5" class="muted">Todavía no hay versiones.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('../partials/footer') %>
