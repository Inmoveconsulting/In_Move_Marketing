<%- include('../partials/header') %>

<div class="perfil-header">
  <div>
    <h1>Contenido</h1>
    <% if (plan) { %><span class="muted small">Plan v<%= plan.version %> — <%= plan.duracion_dias %> días</span><% } %>
  </div>
  <div class="perfil-actions">
    <a href="/productos/<%= producto.slug %>/plan">← plan de marketing</a>
  </div>
</div>

<% if (!plan) { %>
  <p class="callout">
    Este producto todavía no tiene un plan de marketing aprobado. Hace falta aprobar el
    plan antes de generar contenido —
    <a href="/productos/<%= producto.slug %>/plan">ir al plan de marketing</a>.
  </p>
<% } else { %>

  <% if (error) { %>
    <p class="callout callout-error"><%= error %></p>
  <% } %>

  <p class="field-help">
    Se genera de a una semana por vez, no el plan completo. Primero los copys (un pilar
    distinto por semana, rotan sobre los del plan); recién con los copys ya creados se
    pueden generar las imágenes. Cada imagen la genera la IA (OpenAI) usando el prompt de
    Identidad visual — el titular, la bajada y el logo se agregan aparte, con código, para
    que salgan siempre nítidos. Las piezas de Email no llevan imagen.
    Todo queda en borrador — todavía no hay cola de aprobación.
  </p>
  <% if (!hayIdentidad) { %>
    <p class="callout">
      Para crear imágenes hace falta aprobar
      <a href="/productos/<%= producto.slug %>/identidad-visual">Identidad visual</a> primero.
    </p>
  <% } %>

  <% semanas.forEach(function (s) { %>
    <section class="plan-section">
      <h2>Semana <%= s.numero %><% if (s.pilar) { %> — <%= s.pilar.pilar %><% } %></h2>
      <% if (s.pilar) { %>
        <p class="muted small"><%= s.pilar.descripcion %> · CTA: <%= s.pilar.cta %></p>
      <% } %>

      <% if (s.piezas.length === 0) { %>
        <form method="POST" action="/productos/<%= producto.slug %>/contenido/generar-semana">
          <input type="hidden" name="numero" value="<%= s.numero %>">
          <button type="submit">Generar semana <%= s.numero %></button>
        </form>
      <% } else { %>

        <% if (hayIdentidad && s.faltanImagenes) { %>
          <form method="POST" action="/productos/<%= producto.slug %>/contenido/generar-imagenes-semana">
            <input type="hidden" name="numero" value="<%= s.numero %>">
            <button type="submit">Crear imágenes de la semana <%= s.numero %></button>
          </form>
        <% } %>

        <div class="piezas-grid">
          <% s.piezas.forEach(function (p) { %>
            <div class="pieza-card" id="pieza-<%= p.id %>">
              <span class="badge badge-vacio"><%= p.canal %></span>
              <form method="POST" action="/productos/<%= producto.slug %>/contenido/pieza/<%= p.id %>/copy">
                <textarea id="copy-<%= p.id %>" name="copy" rows="8"><%= p.copy || '' %></textarea>
                <div class="form-actions">
                  <button type="submit">Guardar copy</button>
                  <button type="button" class="btn-copiar" data-target="copy-<%= p.id %>">📋 Copiar</button>
                </div>
              </form>
              <form method="POST" action="/productos/<%= producto.slug %>/contenido/pieza/<%= p.id %>/regenerar">
                <button type="submit">Regenerar copy</button>
              </form>

              <% if (!canalesSinImagen.includes(p.canal)) { %>
                <% if (p.imagen_ref) { %>
                  <img class="identidad-thumb" src="<%= p.imagen_ref %>" alt="Imagen de la pieza">
                <% } %>

                <% if (hayIdentidad) { %>
                  <form method="POST" action="/productos/<%= producto.slug %>/contenido/pieza/<%= p.id %>/imagen-ia">
                    <label class="muted small">Titular (vacío = lo escribe la IA)</label>
                    <textarea name="texto_imagen" rows="2"><%= p.texto_imagen || '' %></textarea>
                    <label class="muted small">Bajada</label>
                    <textarea name="bajada_imagen" rows="2"><%= p.bajada_imagen || '' %></textarea>
                    <div class="form-actions">
                      <button type="submit"><%= p.imagen_ref ? 'Regenerar imagen' : 'Crear imagen' %></button>
                    </div>
                  </form>
                <% } %>

                <form method="POST" action="/productos/<%= producto.slug %>/contenido/pieza/<%= p.id %>/imagen" enctype="multipart/form-data">
                  <input type="file" name="imagen" accept="image/*">
                  <div class="form-actions">
                    <button type="submit">O subir la mía</button>
                  </div>
                </form>
              <% } else { %>
                <p class="muted small" style="margin-top:10px">Este canal no lleva imagen.</p>
              <% } %>
            </div>
          <% }); %>
        </div>

        <% if (!s.completa) { %>
          <form method="POST" action="/productos/<%= producto.slug %>/contenido/generar-semana">
            <input type="hidden" name="numero" value="<%= s.numero %>">
            <button type="submit">Completar semana <%= s.numero %> (<%= s.piezas.length %>/<%= s.totalEsperado %>)</button>
          </form>
        <% } %>
      <% } %>
    </section>
  <% }); %>

<% } %>

<%- include('../partials/footer') %>
