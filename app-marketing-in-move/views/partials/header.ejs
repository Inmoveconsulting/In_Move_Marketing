<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>In Move Marketing<%= typeof producto !== 'undefined' && producto ? ' · ' + producto.nombre : '' %></title>
  <link rel="stylesheet" href="/style.css">
  <script src="/app.js" defer></script>
</head>
<body>
  <header class="topbar">
    <a href="/" class="brand">In Move Marketing</a>
    <% if (typeof producto !== 'undefined' && producto) { %>
      <span class="topbar-sep">/</span>
      <span class="topbar-producto"><%= producto.nombre %></span>
    <% } %>
  </header>
  <% if (typeof producto !== 'undefined' && producto) { %>
    <nav class="workspace-nav">
      <a href="/productos/<%= producto.slug %>/perfil">Perfil</a>
      <a href="/productos/<%= producto.slug %>/plan">Plan</a>
      <a href="/productos/<%= producto.slug %>/identidad-visual">Identidad visual</a>
      <a href="/productos/<%= producto.slug %>/contenido">Contenido</a>
    </nav>
  <% } %>
  <main class="container">
